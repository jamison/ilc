{
    "_superseded": "SUPERSEDED — HISTORICAL ARCHIVE ONLY. G4-era draft (Phase 69a, 2026-02-01). Pre-dates CDL-051, ADR-0004 revision, and no-wall-clock/no-float rules. Contains 'created_at' (ISO 8601 wall-clock) which is PROHIBITED under current rules. The anyOf float/string pattern for reward_total/stake_total is also non-canonical — current rule mandates Decimal string only. Not a governing source. Canonical authority: ADR-0004, CDL-051, docs/specs/ilc_commit_epoch_causal_frontier_mapping_spec_1226_v0.1.md.",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://ilc-protocol.org/schemas/commit_epoch_event.v0.1.json",
    "title": "ILC Commit Epoch Event (SUPERSEDED — see _superseded field)",
    "description": "SUPERSEDED DRAFT. Schema for the commit.epoch finalization event in the ILC protocol. Pre-CDL-051. Do not use.",
    "type": "object",
    "required": [
        "event_kind",
        "epoch_index",
        "epoch_id",
        "namespace_id",
        "created_at",
        "finalization_state",
        "summary",
        "checksums"
    ],
    "properties": {
        "event_kind": {
            "type": "string",
            "const": "commit.epoch"
        },
        "epoch_index": {
            "type": "integer",
            "minimum": 0,
            "description": "Monotonically increasing epoch number."
        },
        "epoch_id": {
            "type": "string",
            "description": "Unique identifier for this epoch instance."
        },
        "namespace_id": {
            "type": "string",
            "description": "NodeID or CID of the emitting entity."
        },
        "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp (UTC)."
        },
        "finalization_state": {
            "type": "string",
            "enum": [
                "committed",
                "rolled_back",
                "superseded"
            ],
            "description": "State of the epoch finalization."
        },
        "summary": {
            "type": "object",
            "required": [
                "task_count",
                "agent_count",
                "reward_total",
                "stake_total"
            ],
            "properties": {
                "task_count": {
                    "type": "integer",
                    "minimum": 0
                },
                "agent_count": {
                    "type": "integer",
                    "minimum": 0
                },
                "reward_total": {
                    "anyOf": [
                        {
                            "type": "number",
                            "minimum": 0.0
                        },
                        {
                            "type": "string",
                            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                        }
                    ]
                },
                "stake_total": {
                    "anyOf": [
                        {
                            "type": "number",
                            "minimum": 0.0
                        },
                        {
                            "type": "string",
                            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                        }
                    ]
                }
            }
        },
        "checksums": {
            "type": "object",
            "required": [
                "epoch_events_cid",
                "epoch_state_cid"
            ],
            "properties": {
                "epoch_events_cid": {
                    "type": "string",
                    "description": "CID of the full event log segment."
                },
                "epoch_state_cid": {
                    "type": "string",
                    "description": "CID of the state snapshot."
                }
            }
        }
    },
    "additionalProperties": false
}
