\f0\fs24 \cf0 \{\
  "$schema": "http://json-schema.org/draft-07/schema#",\
  "title": "ILC Master Node Schema v1.1 (Recursive)",\
  "description": "The atomic, executable unit of the Intelligent Labor Coin protocol. Defines the structure for Truth (Objective), Art (Subjective), and all emergent L2/L3 logic.",\
  "version": "1.1.0",\
  "type": "object",\
  "required": ["node_id", "opcode", "claim_class_ref", "payload", "provenance"],\
  "properties": \{\
    \
    "node_id": \{\
      "type": "string",\
      "description": "SHA-256 Hash of the payload + provenance. Acts as the Content ID (CID) for the graph."\
    \},\
\
    "opcode": \{\
      "type": "string",\
      "description": "The 'Physics' of the system. Hard-coded primitives that define how the Shard Runtime interprets this object.",\
      "enum": [\
        "assert.truth",        "// A raw claim or statement (The Axiom).",\
        "epistemic.work.task", "// A verification method or proof of labor (The Work).",\
        "star.map",            "// A topological context or index (The Map).",\
        "refute.claim",        "// A validation or rejection signal (The Audit).",\
        "express.art",         "// A subjective creation (The Expression).",\
        "signal.context",      "// A soft signal for L2 markets (e.g., 'Risk', 'Trend')."\
      ]\
    \},\
\
    "claim_class_ref": \{\
      "type": "string",\
      "description": "Pointer to a Taxonomy Node that defines the truth-class (e.g., 'node_genesis_objective' or 'node_genesis_subjective'). Replaces hard-coded enums to allow evolving epistemology."\
    \},\
\
    "payload": \{\
      "type": "object",\
      "description": "The executable or informational content. Structure varies by Opcode.",\
      "properties": \{\
        "statement": \{ \
          "type": "string",\
          "description": "The core assertion in natural language or formal logic." \
        \},\
        "logic_hash": \{ \
          "type": "string", \
          "description": "Hash of the formal logic file (e.g., Lean/Coq proof) for automated verification." \
        \},\
        "method_ref": \{\
          "type": "string", \
          "description": "Pointer to a Method Node defining the verification protocol (e.g., 'node_method_double_blind_v1')."\
        \},\
        "inputs": \{ \
          "type": "array",\
          "description": "List of Node IDs or Data CIDs used as input for the work."\
        \},\
        "compute_proof": \{\
          "type": "object",\
          "description": "The cryptographic proof of hardware/energy expenditure (CapProof).",\
          "properties": \{\
            "hardware_ref": \{ \
              "type": "string",\
              "description": "Pointer to a Hardware Spec Node (e.g., 'node_spec_nvidia_h100')."\
            \},\
            "proof_signature": \{ "type": "string" \},\
            "watts_estimated": \{ "type": "number" \}\
          \}\
        \}\
      \}\
    \},\
\
    "rights": \{\
      "type": "object",\
      "description": "Defines the economic logic for this node. Points to a 'Policy Node' that contains the executable rules.",\
      "properties": \{\
        "policy_ref": \{ \
          "type": "string", \
          "description": "The Node ID of the Rights Policy (e.g., 'node_policy_open_license' or 'node_policy_auction_v4')." \
        \},\
        "parameters": \{\
          "type": "object",\
          "description": "Specific inputs required by that Policy (e.g., 'Price = 5 ILC', 'Beneficiary = Wallet_X')."\
        \}\
      \},\
      "required": ["policy_ref"]\
    \},\
\
    "provenance": \{\
      "type": "object",\
      "description": "The immutable history of this node.",\
      "properties": \{\
        "agent_id": \{ "type": "string", "description": "The identity creating the node." \},\
        "signature": \{ "type": "string", "description": "Cryptographic signature of the node_id by the agent." \},\
        "timestamp": \{ "type": "integer", "description": "Unix timestamp." \},\
        "parent_hash": \{ "type": "string", "description": "The node this derived from (if applicable)." \},\
        "shard_id": \{ "type": "string", "description": "The network shard where this node was minted." \}\
      \}\
    \}\
  \}\
\}}