{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://ilc-protocol.org/schemas/cluster_a/acceptance_evidence/v0.1",
    "title": "ILC Cluster A Acceptance Evidence v0.1",
    "type": "object",
    "required": [
        "artifact_kind",
        "artifact_version",
        "record_uid",
        "record_hash_sha256",
        "generated_at",
        "accepted",
        "conformance_ok",
        "acceptance_errors",
        "acceptance_warnings",
        "constitution_checks"
    ],
    "additionalProperties": false,
    "properties": {
        "artifact_kind": {
            "const": "cluster_a_acceptance_evidence"
        },
        "artifact_version": {
            "const": "v0.1"
        },
        "record_uid": {
            "type": "string",
            "minLength": 1
        },
        "record_hash_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
        },
        "transcript_hash_sha256": {
            "type": [
                "string",
                "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
        },
        "generated_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
        },
        "accepted": {
            "type": "boolean"
        },
        "conformance_ok": {
            "type": "boolean"
        },
        "acceptance_errors": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "acceptance_warnings": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "constitution_checks": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "check_id",
                    "status"
                ],
                "additionalProperties": false,
                "properties": {
                    "check_id": {
                        "type": "string",
                        "minLength": 1
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "pass",
                            "fail",
                            "not_applicable"
                        ]
                    },
                    "error_code": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "details": {
                        "type": [
                            "object",
                            "null"
                        ]
                    }
                }
            }
        },
        "policy_state_delta": {
            "type": [
                "object",
                "null"
            ]
        }
    }
}