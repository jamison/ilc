{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://schemas.ilc.org/ilc_cluster_a_replay_proof_batch_report_v0.1.json",
    "title": "ILC Cluster A Replay Proof Batch Report v0.1",
    "type": "object",
    "required": [
        "report_version",
        "total_packages",
        "ok_count",
        "fail_count",
        "ok",
        "results",
        "error_token_counts",
        "batch_errors"
    ],
    "additionalProperties": false,
    "properties": {
        "report_version": {
            "type": "string",
            "const": "v0.1"
        },
        "total_packages": {
            "type": "integer",
            "minimum": 0
        },
        "ok_count": {
            "type": "integer",
            "minimum": 0
        },
        "fail_count": {
            "type": "integer",
            "minimum": 0
        },
        "ok": {
            "type": "boolean"
        },
        "results": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "input_index",
                    "source_id",
                    "ok",
                    "errors",
                    "warnings",
                    "checks"
                ],
                "additionalProperties": false,
                "properties": {
                    "input_index": {
                        "type": "integer",
                        "minimum": 0
                    },
                    "source_id": {
                        "type": "string"
                    },
                    "ok": {
                        "type": "boolean"
                    },
                    "errors": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "warnings": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "checks": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": [
                                "check",
                                "status",
                                "error_code"
                            ],
                            "additionalProperties": false,
                            "properties": {
                                "check": {
                                    "type": "string"
                                },
                                "status": {
                                    "type": "string",
                                    "enum": [
                                        "pass",
                                        "fail"
                                    ]
                                },
                                "error_code": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "error_token_counts": {
            "type": "object",
            "additionalProperties": {
                "type": "integer",
                "minimum": 0
            }
        },
        "batch_errors": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    }
}
