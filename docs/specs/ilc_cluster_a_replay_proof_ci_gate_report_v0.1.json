{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://schemas.ilc.org/ilc_cluster_a_replay_proof_ci_gate_report_v0.1.json",
    "title": "ILC Cluster A Replay Proof CI Gate Report v0.1",
    "type": "object",
    "required": [
        "gate_version",
        "profile",
        "ok",
        "pass_count",
        "fail_count",
        "checks",
        "error_token_counts",
        "exit_code",
        "error_token"
    ],
    "additionalProperties": false,
    "properties": {
        "gate_version": {
            "type": "string",
            "const": "v0.1"
        },
        "profile": {
            "type": "string"
        },
        "ok": {
            "type": "boolean"
        },
        "pass_count": {
            "type": "integer",
            "minimum": 0
        },
        "fail_count": {
            "type": "integer",
            "minimum": 0
        },
        "checks": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "check_id",
                    "ok",
                    "expected",
                    "actual",
                    "error_token"
                ],
                "additionalProperties": false,
                "properties": {
                    "check_id": {
                        "type": "string"
                    },
                    "ok": {
                        "type": "boolean"
                    },
                    "expected": {
                        "type": [
                            "string",
                            "number",
                            "boolean",
                            "object",
                            "array",
                            "null"
                        ]
                    },
                    "actual": {
                        "type": [
                            "string",
                            "number",
                            "boolean",
                            "object",
                            "array",
                            "null"
                        ]
                    },
                    "error_token": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                }
            }
        },
        "error_token_counts": {
            "type": "object",
            "additionalProperties": {
                "type": "integer",
                "minimum": 0
            }
        },
        "exit_code": {
            "type": "integer",
            "enum": [
                0,
                1,
                2
            ]
        },
        "error_token": {
            "type": [
                "string",
                "null"
            ]
        }
    }
}
